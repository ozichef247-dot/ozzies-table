# ---- Site ----
# Public address of the site, no trailing slash. Used in emails, payment return links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.ozziestable.com
# For local development use: http://localhost:3000

# ---- Supabase (Project settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Revolut Merchant API (Revolut Business → Merchant → API) ----
# "sandbox" while testing, "prod" for live payments.
REVOLUT_MODE=sandbox
# The public key (pk_...) is safe to show in the browser; the server passes it to the payment form.
REVOLUT_PUBLIC_KEY=
REVOLUT_SECRET_KEY=
# Signing secret returned when the webhook is created (npm run revolut:webhook).
REVOLUT_WEBHOOK_SECRET=

# ---- Email (Resend: resend.com → API keys) ----
# Leave RESEND_API_KEY empty to record emails in the dashboard without sending them.
RESEND_API_KEY=
EMAIL_FROM="Ozzie's Table <orders@ozziestable.com>"

# ---- Scheduled clean-up (Vercel Cron sends this as a Bearer token) ----
CRON_SECRET=

# ---- Analytics (optional, only loaded after cookie consent) ----
# Plausible or similar: the script URL and domain.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
